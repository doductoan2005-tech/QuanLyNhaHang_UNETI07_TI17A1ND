@* Họ và tên : VU CONG VINH
   Mã sinh viên : 23203100012
   Nội dung thực hiện: Xóa tài khoản *@
@model TaiKhoan
@{ ViewData["Title"] = "Xóa tài khoản"; var lyDo = ViewBag.LyDoChan as string; }
<h3 class="section-title text-danger">Xóa tài khoản</h3>
<div class="card p-4 col-lg-7">
    @if (lyDo != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>@lyDo</div>
    }
    <p>Bạn có chắc chắn muốn xóa tài khoản <b>@Model.TenDangNhap</b> (@Model.HoTen) không?</p>
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.MaTaiKhoan" />
        <button type="submit" class="btn btn-danger" disabled="@(lyDo != null)"><i class="bi bi-trash me-1"></i>Xác nhận xóa</button>
        <a asp-action="Index" class="btn btn-outline-dark">Hủy</a>
    </form>
</div>
