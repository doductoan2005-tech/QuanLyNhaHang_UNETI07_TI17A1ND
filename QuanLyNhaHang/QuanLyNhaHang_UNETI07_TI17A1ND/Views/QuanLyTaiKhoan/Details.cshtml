@* Họ và tên : VU CONG VINH
   Mã sinh viên : 23203100012
   Nội dung thực hiện: Chi tiết tài khoản *@
@model TaiKhoan
@{ ViewData["Title"] = "Chi tiết tài khoản"; }
<h3 class="section-title">Chi tiết tài khoản</h3>
<div class="card p-4 col-lg-7">
    <dl class="row mb-0">
        <dt class="col-sm-4">Tên đăng nhập</dt><dd class="col-sm-8">@Model.TenDangNhap</dd>
        <dt class="col-sm-4">Họ tên</dt><dd class="col-sm-8">@Model.HoTen</dd>
        <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@Model.Email</dd>
        <dt class="col-sm-4">Vai trò</dt><dd class="col-sm-8">@(Model.VaiTro == VaiTro.Admin ? "Admin" : "Khách hàng")</dd>
        <dt class="col-sm-4">Trạng thái</dt>
        <dd class="col-sm-8"><span class="badge @(Model.TrangThai ? "badge-soft-success" : "badge-soft-danger")">@(Model.TrangThai ? "Hoạt động" : "Bị khóa")</span></dd>
    </dl>
</div>
<a asp-action="Index" class="btn btn-outline-dark mt-3"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
