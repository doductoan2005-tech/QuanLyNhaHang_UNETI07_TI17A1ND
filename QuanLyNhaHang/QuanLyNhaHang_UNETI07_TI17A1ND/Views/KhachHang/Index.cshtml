// Họ và tên: Phạm Ngọc Hưng (Sinh viên 3)
// Mã sinh viên: 23203100037
// Nội dung thực hiện: Trang index Khách hàng
@model List<KhachHang>
@{ ViewData["Title"] = "Quản lý khách hàng"; }
<h3 class="section-title mb-0">Quản lý khách hàng</h3>
<p class="text-muted">Tổng số: @Model.Count() khách hàng</p>

<form method="get" class="filter-panel row g-3 mb-4 align-items-end">
    <div class="col-md-4">
        <label class="form-label"><i class="bi bi-search me-1"></i>Tìm kiếm</label>
        <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tên / email / SĐT..." />
    </div>
    <div class="col-md-2"><button class="btn btn-dark w-100"><i class="bi bi-filter"></i> Tìm</button></div>
</form>

<div class="table-responsive">
<table class="table table-elegant">
    <thead><tr><th>#</th><th>Họ tên</th><th>Email</th><th>SĐT</th><th>Ngày đăng ký</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
    <tbody>
    @foreach (var kh in Model)
    {
        <tr>
            <td>@kh.MaKhachHang</td>
            <td class="fw-semibold">@kh.HoTen</td>
            <td>@kh.Email</td>
            <td>@kh.SoDienThoai</td>
            <td>@kh.NgayDangKy.ToString("dd/MM/yyyy")</td>
            <td>
                <form asp-action="ToggleTrangThai" asp-route-id="@kh.MaKhachHang" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm @(kh.TrangThai ? "badge-soft-success" : "badge-soft-danger") border-0">
                        <i class="bi @(kh.TrangThai ? "bi-check-circle-fill" : "bi-lock-fill") me-1"></i>@(kh.TrangThai ? "Hoạt động" : "Bị khóa")
                    </button>
                </form>
            </td>
            <td class="text-end"><a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@kh.MaKhachHang"><i class="bi bi-eye"></i> Xem</a></td>
        </tr>
    }
    </tbody>
</table>
</div>
