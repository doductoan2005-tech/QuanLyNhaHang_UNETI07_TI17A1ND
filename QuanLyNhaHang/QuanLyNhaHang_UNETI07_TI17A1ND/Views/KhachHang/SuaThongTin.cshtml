// Nội dung thực hiện: Sửa thông tin Khách hàng
@model KhachHang
@{ ViewData["Title"] = "Cập nhật thông tin cá nhân"; }
<h3 class="section-title">Cập nhật thông tin cá nhân</h3>
<div class="card p-4 col-lg-7">
    <form asp-action="SuaThongTin" method="post">
        <input type="hidden" asp-for="MaKhachHang" />
        <input type="hidden" asp-for="MaTaiKhoan" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3"><label asp-for="HoTen" class="form-label"></label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen" class="text-danger"></span></div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="NgaySinh" class="form-label"></label><input asp-for="NgaySinh" type="date" class="form-control" /><span asp-validation-for="NgaySinh" class="text-danger"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="GioiTinh" class="form-label"></label><select asp-for="GioiTinh" asp-items="Html.GetEnumSelectList<GioiTinh>()" class="form-select"></select></div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="SoDienThoai" class="form-label"></label><input asp-for="SoDienThoai" class="form-control" /><span asp-validation-for="SoDienThoai" class="text-danger"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
        </div>
        <div class="mb-4"><label asp-for="DiaChi" class="form-label"></label><textarea asp-for="DiaChi" class="form-control" rows="2"></textarea></div>
        <button type="submit" class="btn btn-dark"><i class="bi bi-check-lg me-1"></i>Lưu</button>
        <a asp-action="ThongTinCaNhan" class="btn btn-outline-dark">Hủy</a>
    </form>
</div>
