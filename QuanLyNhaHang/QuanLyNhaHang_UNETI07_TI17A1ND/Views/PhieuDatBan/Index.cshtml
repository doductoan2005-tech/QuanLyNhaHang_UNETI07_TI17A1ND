@model List<PhieuDatBan>
@{
    ViewData["Title"] = "Quản lý phiếu đặt bàn";
    string BadgeTt(TrangThaiPhieu tt) => tt switch
    {
        TrangThaiPhieu.ChoXacNhan => "badge-soft-warning",
        TrangThaiPhieu.DaXacNhan => "badge-soft-info",
        TrangThaiPhieu.DaSuDung => "badge-soft-success",
        _ => "badge-soft-danger"
    };
}

<h3 class="section-title mb-0">Quản lý phiếu đặt bàn</h3>
<p class="text-muted">Tổng số: @Model.Count() phiếu</p>


<form method="get" class="filter-panel row g-3 mb-4 align-items-end">
    <div class="col-md-3">
        <label class="form-label"><i class="bi bi-person me-1"></i>Khách hàng</label>
        <input type="text" name="tenKhach" value="@ViewBag.TenKhach" class="form-control" placeholder="Tên khách hàng..." />
    </div>
    <div class="col-md-2">
        <label class="form-label"><i class="bi bi-table me-1"></i>Bàn</label>
        <input type="text" name="tenBan" value="@ViewBag.TenBan" class="form-control" placeholder="Tên bàn..." />
    </div>
    <div class="col-md-2">
        <label class="form-label">Trạng thái</label>
        <select name="trangThai" class="form-select">
            <option value="">Tất cả</option>
            @foreach (var tt in Enum.GetValues<TrangThaiPhieu>())
            {
                <option value="@((int)tt)" selected="@(ViewBag.TrangThaiLoc?.Equals(tt) == true)">@tt</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Ngày sử dụng</label>
        <input type="date" name="ngaySuDung" value="@ViewBag.NgaySuDungLoc" class="form-control" />
    </div>
    <div class="col-md-2"><button class="btn btn-dark w-100"><i class="bi bi-filter"></i> Lọc</button></div>
</form>

<div class="table-responsive">
<table class="table table-elegant align-middle">
    <thead>
        <tr><th>#</th><th>Khách hàng</th><th>Bàn</th><th>Ngày SD</th><th>Giờ</th><th>SL người</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>#@p.MaPhieu</td>
            <td class="fw-semibold">@p.KhachHang?.HoTen</td>
            <td>@p.BanAn?.TenBan</td>
            <td>@p.NgaySuDung.ToString("dd/MM/yyyy")</td>
            <td>@p.GioBatDau.ToString(@"hh\:mm") - @p.GioKetThuc.ToString(@"hh\:mm")</td>
            <td>@p.SoNguoi</td>
            <td><span class="badge @BadgeTt(p.TrangThai)">@p.TrangThai</span></td>
            <td class="text-end">
                <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
                    <a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@p.MaPhieu"><i class="bi bi-eye"></i></a>
                    @if (p.TrangThai == TrangThaiPhieu.ChoXacNhan)
                    {
                        <form asp-action="XacNhan" asp-route-id="@p.MaPhieu" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success" title="Xác nhận"><i class="bi bi-check-lg"></i></button>
                        </form>
                        <form asp-action="Huy" asp-route-id="@p.MaPhieu" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy"><i class="bi bi-x-lg"></i></button>
                        </form>
                    }
                    @if (p.TrangThai == TrangThaiPhieu.DaXacNhan)
                    {
                        <form asp-action="BatDauSuDung" asp-route-id="@p.MaPhieu" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Bắt đầu dùng"><i class="bi bi-hourglass-split"></i></button>
                        </form>
                        <form asp-action="KetThucSuDung" asp-route-id="@p.MaPhieu" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Hoàn tất"><i class="bi bi-flag-fill"></i></button>
                        </form>
                        <form asp-action="Huy" asp-route-id="@p.MaPhieu" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Hủy"><i class="bi bi-x-lg"></i></button>
                        </form>
                    }
                </div>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
