@* Họ và tên : VU CONG VINH
   Mã sinh viên : 23203100012
   Nội dung thực hiện: quản lý loại bàn *@
@model List<LoaiBan>
@{ ViewData["Title"] = "Quản lý loại bàn"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="section-title mb-0">Quản lý loại bàn</h3>
        <p class="text-muted mb-0">Danh sách các loại bàn trong nhà hàng</p>
    </div>
    <a class="btn btn-gold" asp-action="Create"><i class="bi bi-plus-circle me-1"></i> Thêm loại bàn</a>
</div>

<div class="table-responsive">
<table class="table table-elegant">
    <thead>
        <tr><th>#</th><th>Tên loại bàn</th><th>Mô tả</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr>
    </thead>
    <tbody>
    @foreach (var lb in Model)
    {
        <tr>
            <td>@lb.MaLoaiBan</td>
            <td class="fw-semibold">@lb.TenLoaiBan</td>
            <td class="text-muted">@lb.MoTa</td>
            <td>
                <form asp-action="ToggleTrangThai" asp-route-id="@lb.MaLoaiBan" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm @(lb.TrangThai ? "badge-soft-success" : "badge-soft-danger") border-0">
                        <i class="bi @(lb.TrangThai ? "bi-check-circle-fill" : "bi-slash-circle-fill") me-1"></i>@(lb.TrangThai ? "Hoạt động" : "Ngừng")
                    </button>
                </form>
            </td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-dark" asp-action="Details" asp-route-id="@lb.MaLoaiBan"><i class="bi bi-eye"></i></a>
                <a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@lb.MaLoaiBan"><i class="bi bi-pencil"></i></a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@lb.MaLoaiBan"><i class="bi bi-trash"></i></a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
