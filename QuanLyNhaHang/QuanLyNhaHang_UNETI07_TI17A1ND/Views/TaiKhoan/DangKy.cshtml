// Họ và tên: Vũ Công Vinh (Sinh viên 1)
// Mã sinh viên: 23203100012
// Nội dung thực hiện: Entity Tài khoản - Đăng nhập - Phân quyền
@model DangKyVM
@{ ViewData["Title"] = "Đăng ký"; }

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="auth-panel row g-0">
            <div class="col-md-4 d-none d-md-block">
                <div class="auth-side">
                    <i class="bi bi-person-plus-fill"></i>
                    <h3 class="text-white">Tham gia cùng chúng tôi</h3>
                    <p style="color: rgba(255,255,255,0.85)">Tạo tài khoản để đặt bàn nhanh chóng và nhận nhiều ưu đãi hấp dẫn.</p>
                </div>
            </div>
            <div class="col-md-8">
                <div class="p-4 p-md-5">
                    <h3 class="mb-1">Đăng ký tài khoản</h3>
                    <p class="text-muted mb-4">Dành cho khách hàng</p>
                    <form asp-action="DangKy" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="TenDangNhap" class="form-label"></label>
                                <input asp-for="TenDangNhap" class="form-control" />
                                <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="MatKhau" class="form-label"></label>
                                <input asp-for="MatKhau" class="form-control" />
                                <span asp-validation-for="MatKhau" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="HoTen" class="form-label"></label>
                            <input asp-for="HoTen" class="form-control" />
                            <span asp-validation-for="HoTen" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="SoDienThoai" class="form-label"></label>
                                <input asp-for="SoDienThoai" class="form-control" />
                                <span asp-validation-for="SoDienThoai" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NgaySinh" class="form-label"></label>
                                <input asp-for="NgaySinh" type="date" class="form-control" />
                                <span asp-validation-for="NgaySinh" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="GioiTinh" class="form-label"></label>
                                <select asp-for="GioiTinh" asp-items="Html.GetEnumSelectList<GioiTinh>()" class="form-select"></select>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label asp-for="DiaChi" class="form-label"></label>
                            <textarea asp-for="DiaChi" class="form-control" rows="2"></textarea>
                        </div>
                        <button type="submit" class="btn btn-dark w-100"><i class="bi bi-person-check-fill me-1"></i> Đăng ký</button>
                    </form>
                    <p class="mt-3 text-center text-muted">Đã có tài khoản? <a asp-action="Login" class="fw-semibold">Đăng nhập</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
}
